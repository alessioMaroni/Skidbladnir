V "GNAT Lib v16"
A -O2
A -gnatA
A -fno-strict-aliasing
A -fno-unwind-tables
A -fno-asynchronous-unwind-tables
A -mtune=generic
A -march=x86-64
A -mtls-dialect=gnu2
P ZX

RN
RV NO_IMPLEMENTATION_PRAGMAS

U time%b		time.adb		84a7a751 NE OO PK
W interfaces%s		interfac.ads		interfac.ali
W interfaces.c%s	i-c.adb			i-c.ali

U time%s		time.ads		f3a174c9 NE OO PU PK
W interfaces%s		interfac.ads		interfac.ali
W interfaces.c%s	i-c.adb			i-c.ali

D ada.ads		20260819000000 76789da1 ada%s
D a-unccon.ads		20260819000000 0e9b276f ada.unchecked_conversion%s
D interfac.ads		20260819000000 9111f9c1 interfaces%s
D i-c.ads		20260819000000 dbdd3be7 interfaces.c%s
D system.ads		20260819000000 e2b7c99d system%s
D s-exctab.ads		20260819000000 91bef6ef system.exception_table%s
D s-parame.ads		20260819000000 a1aeab5c system.parameters%s
D s-stalib.ads		20260819000000 1c9580f6 system.standard_library%s
D time.ads		20260825090114 287c4f2e time%s
D time.adb		20260825090114 7706d398 time%b
G a e
G c Z s b [sum_integer time 6 13 none]
X 3 interfac.ads
47K9*Interfaces 247e15 9|1r6 1r24 10|1r6 1r24
X 4 i-c.ads
33K20*C 605e17 9|1w17 1r35 10|1w17 1r35
62I9*int<integer> 9|6r30 6r39 6r51 10|5r30 5r39 5r51
X 9 time.ads
3K9*Time 4r17 11l5 11e9 10|3b14 10l5 10t9
6V13*Sum_Integer{4|62I9} 6>26 6>35 10|5b13 8l8 8t19
6i26 A{4|62I9} 10|5b26 7r14
6i35 B{4|62I9} 10|5b35 7r18

