abstract project Shared is
   for Languages use ("Ada");

   package Compiler is
      for Switches ("Ada") use (
         "-O2",
         "-fno-strict-aliasing",
         "-fno-PIC",
         "-fno-pie",
         "-mno-red-zone",
         "-nostdlib",
         "-ffreestanding"
      );
   end Compiler;
end Shared;